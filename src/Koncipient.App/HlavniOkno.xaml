<Window x:Class="Koncipient.App.HlavniOkno"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Koncipient" Height="850" Width="1400" WindowState="Maximized"
        FontFamily="Segoe UI" FontSize="13">
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top" IsLocked="True">
            <ToolBar>
                <Button Content="Nový spis" Click="NovySpis_Click" Padding="8,4" />
                <Button x:Name="PridatFotky" Content="Přidat fotky…" Click="PridatFotky_Click" Padding="8,4" IsEnabled="False" />
                <Separator />
                <Button x:Name="SpustitPrepis" Content="Spustit přepis" Click="SpustitPrepis_Click" Padding="8,4"
                        ToolTip="Narovná a přepíše všechny strany bez přepisu a najde v nich údaje. Může běžet přes noc, počítač mezitím neusne." />
                <Button x:Name="Zastavit" Content="Zastavit" Click="Zastavit_Click" Padding="8,4" IsEnabled="False" />
                <Separator />
                <TextBlock Text="Zvětšení" VerticalAlignment="Center" Margin="8,0,4,0" />
                <Slider x:Name="Zvetseni" Minimum="0.1" Maximum="3" Value="0.5" Width="120" VerticalAlignment="Center"
                        ValueChanged="Zvetseni_ValueChanged" />
                <Button Content="Na šířku" Click="NaSirku_Click" Padding="8,4" />
                <Button Content="⟲" Click="OtocitVlevo_Click" Padding="8,4" ToolTip="Otočit stranu doleva" />
                <Button Content="⟳" Click="OtocitVpravo_Click" Padding="8,4" ToolTip="Otočit stranu doprava" />
            </ToolBar>
            <ToolBar>
                <Button x:Name="NajitUdaje" Content="Najít údaje" Click="NajitUdaje_Click" Padding="8,4" IsEnabled="False"
                        ToolTip="Projde všechny přepsané strany spisu a najde jména, adresy, čísla a další údaje." />
                <ToggleButton x:Name="Nahled" Content="Náhled pro Clauda" Click="Nahled_Click" Padding="8,4"
                              ToolTip="Ukáže text strany tak, jak ho dostane Claude." />
                <CheckBox x:Name="Zkontrolovano" Content="Strana zkontrolována" VerticalAlignment="Center" Margin="8,0"
                          Click="Zkontrolovano_Click" IsEnabled="False" />
                <Button x:Name="Exportovat" Content="Exportovat pro Clauda…" Click="Exportovat_Click" Padding="8,4" IsEnabled="False" />
                <Separator />
                <Button x:Name="VratitJmena" Content="Vrátit jména do výstupu od Clauda…" Click="VratitJmena_Click" Padding="8,4" IsEnabled="False"
                        ToolTip="Otevře dokument od Clauda, vrátí do něj skutečná jména a uloží ho jako Word." />
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <ProgressBar x:Name="Prubeh" Width="200" Height="14" Visibility="Collapsed" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="Stav" Text="Připraveno" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock>
                    <Run Background="#E1BEE7" Text=" údaj " />
                    <Run Text="  " /><Run Background="#FFE0B2" Text=" sporné čtení " />
                    <Run Text="  " /><Run Background="#C8E6C9" Text=" opraveno " />
                    <Run Text="   klik = místo na fotce, Shift+klik = více slov, dvojklik = oprava, pravé tlačítko = úpravy a anonymizace, Ctrl+tažení na fotce = doplnit vynechaný text" Foreground="Gray" />
                </TextBlock>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="3*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Spisy" FontWeight="SemiBold" Margin="6,6,6,2" />
                <ListBox x:Name="SeznamSpisu" Grid.Row="1" SelectionChanged="SeznamSpisu_SelectionChanged" />
                <TextBlock Grid.Row="2" Text="Strany   (✓ přepsáno, ✎ opraveno, ☑ zkontrolováno)" FontWeight="SemiBold" Margin="6,8,6,2" TextWrapping="Wrap" />
                <ListBox x:Name="SeznamStran" Grid.Row="3" SelectionChanged="SeznamStran_SelectionChanged" />
            </Grid>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />

            <TabControl x:Name="Zalozky" Grid.Column="2" SelectionChanged="Zalozky_SelectionChanged">
                <TabItem Header="Text strany">
                    <FlowDocumentScrollViewer x:Name="TextStrany" VerticalScrollBarVisibility="Auto">
                        <FlowDocumentScrollViewer.ContextMenu>
                            <ContextMenu x:Name="MenuSlova">
                                <MenuItem Header="Anonymizovat jako osobu" Tag="Osoba" Click="OznacitJako_Click" />
                                <MenuItem Header="Anonymizovat jako firmu" Tag="Firma" Click="OznacitJako_Click" />
                                <MenuItem Header="Anonymizovat jako adresu" Tag="Adresa" Click="OznacitJako_Click" />
                                <MenuItem Header="Anonymizovat jako nemovitost" Tag="Nemovitost" Click="OznacitJako_Click" />
                                <MenuItem Header="Anonymizovat jako spisovou značku" Tag="SpisovaZnacka" Click="OznacitJako_Click" />
                                <MenuItem Header="Odstranit (jiný citlivý údaj)" Tag="Jiny" Click="OznacitJako_Click" />
                                <Separator />
                                <MenuItem Header="Není citlivé" Click="Necitlive_Click" />
                                <Separator />
                                <MenuItem Header="Opravit slovo…" Click="OpravitSlovo_Click" />
                                <MenuItem Header="Doplnit vynechaný text za toto slovo…" Click="DoplnitZa_Click" />
                                <MenuItem Header="Smazat vybraná slova" Click="SmazatSlova_Click" />
                                <Separator />
                                <MenuItem Header="Zalomit řádek před tímto slovem" Click="Zalomit_Click" />
                                <MenuItem Header="Spojit řádek s dalším" Click="Spojit_Click" />
                                <MenuItem Header="Posunout řádek nahoru" Tag="-1" Click="PosunoutRadek_Click" />
                                <MenuItem Header="Posunout řádek dolů" Tag="1" Click="PosunoutRadek_Click" />
                            </ContextMenu>
                        </FlowDocumentScrollViewer.ContextMenu>
                        <FlowDocument FontFamily="Segoe UI" FontSize="15" PagePadding="16" />
                    </FlowDocumentScrollViewer>
                </TabItem>
                <TabItem Header="Osoby a údaje">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top" Margin="4">
                            <Button Content="Nahradit" Click="UdajPseudonym_Click" Padding="8,3" Margin="2" ToolTip="Údaj se v textu pro Clauda nahradí." />
                            <Button Content="Odstranit" Click="UdajOdstranit_Click" Padding="8,3" Margin="2" ToolTip="Údaj se z textu úplně vypustí." />
                            <Button Content="Tohle neanonymizovat" Click="UdajPonechat_Click" Padding="8,3" Margin="2"
                                    ToolTip="Údaj zůstane v textu pro Clauda tak, jak je ve spisu (soud, úřad, obec…)." />
                            <Button Content="Jiné vymyšlené jméno" Click="UdajNoveJmeno_Click" Padding="8,3" Margin="2" />
                            <Button Content="Smazat" Click="UdajSmazat_Click" Padding="8,3" Margin="2" ToolTip="Údaj není citlivý ani nesouvisí, odebrat z klíče." />
                            <TextBlock Text="Osoby nahrazovat:" VerticalAlignment="Center" Margin="12,0,4,0" />
                            <ComboBox x:Name="StylOsob" Width="200" SelectionChanged="StylOsob_SelectionChanged">
                                <ComboBoxItem Content="vymyšlenými jmény (stromy)" Tag="Stromy" />
                                <ComboBoxItem Content="vymyšlenými jmény (zvířata)" Tag="Zvirata" />
                                <ComboBoxItem Content="kódy [OSOBA_001]" Tag="Kody" />
                            </ComboBox>
                            <Button Content="Převzít z jiného spisu…" Click="Prevzit_Click" Padding="8,3" Margin="8,2,2,2"
                                    ToolTip="Stejné osoby dostanou stejná vymyšlená jména jako v jiném spisu." />
                        </WrapPanel>
                        <TextBlock DockPanel.Dock="Bottom" Margin="6" Foreground="Gray" TextWrapping="Wrap"
                                   Text="Skutečné jméno, náhradu a roli jde přepsat dvojklikem. Skutečné jméno v 1. pádě se vrací do dokumentů od Clauda, proto ho oprav, pokud ho OCR přečetlo chybně. Odsazené řádky patří k osobě nad nimi." />
                        <DataGrid x:Name="TabulkaUdaju" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column" SelectionMode="Extended" GridLinesVisibility="Horizontal"
                                  CellEditEnding="TabulkaUdaju_CellEditEnding" RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Údaj" Binding="{Binding Udaj, Mode=OneWay}" IsReadOnly="True" Width="Auto" />
                                <DataGridTextColumn Header="Skutečnost" Binding="{Binding Skutecnost}" Width="2*" />
                                <DataGridTextColumn Header="Pro Clauda" Binding="{Binding Nahrada}" Width="2*" />
                                <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="*" />
                                <DataGridTextColumn Header="Akce" Binding="{Binding AkceText, Mode=OneWay}" IsReadOnly="True" Width="Auto" />
                                <DataGridCheckBoxColumn Header="Iniciály" Binding="{Binding Inicialy, UpdateSourceTrigger=PropertyChanged}" Width="Auto" />
                                <DataGridTextColumn Header="Tvary v textu" Binding="{Binding Tvary, Mode=OneWay}" IsReadOnly="True" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" />

            <ScrollViewer x:Name="FotkaScroll" Grid.Column="4" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto" Background="#F0F0F0"
                          PreviewMouseWheel="FotkaScroll_PreviewMouseWheel">
                <Grid x:Name="Platno" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid.LayoutTransform>
                        <ScaleTransform x:Name="Meritko" ScaleX="0.5" ScaleY="0.5" />
                    </Grid.LayoutTransform>
                    <Image x:Name="Fotka" Stretch="Fill" Cursor="Hand"
                           MouseLeftButtonDown="Fotka_MouseLeftButtonDown" MouseMove="Fotka_MouseMove"
                           MouseLeftButtonUp="Fotka_MouseLeftButtonUp" />
                    <Canvas x:Name="Vrstva" IsHitTestVisible="False" />
                </Grid>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
