<Window x:Class="Koncipient.App.HlavniOkno"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Koncipient" Height="850" Width="1400" WindowState="Maximized"
        FontFamily="Segoe UI" FontSize="13" PreviewKeyDown="Okno_PreviewKeyDown">
    <DockPanel>
        <Menu DockPanel.Dock="Top" AutomationProperties.AutomationId="Nabidka">
            <MenuItem Header="_Spis">
                <MenuItem Header="Nový spis" Click="NovySpis_Click" InputGestureText="Ctrl+N" />
                <MenuItem Header="Přidat fotky nebo PDF…" Click="PridatFotky_Click" InputGestureText="Ctrl+O" />
                <MenuItem Header="Přidat složku…" Click="PridatSlozku_Click" InputGestureText="Ctrl+Shift+O" />
                <MenuItem x:Name="Oddelovace" AutomationProperties.AutomationId="Oddelovace" Header="Oddělovače dokumentů…" Click="Oddelovace_Click" IsEnabled="False"
                          ToolTip="Fotky vzaté jako oddělovače dokumentů (zakrytý objektiv). Skutečnou stránku jde vrátit mezi strany." />
                <MenuItem x:Name="KPrefoceni" AutomationProperties.AutomationId="KPrefoceni" Header="Stránky k přefocení…" Click="KPrefoceni_Click"
                          ToolTip="Strany, které vyšly špatně (rozmazané, tmavé, uříznuté), s možností nahradit je novou fotkou." />
                <Separator />
                <MenuItem x:Name="Zalohovat" AutomationProperties.AutomationId="Zalohovat" Header="Zálohovat spisy…" Click="Zalohovat_Click"
                          ToolTip="Zkopíruje všechny spisy na externí disk, který zůstává u spisů, a ověří kopii." />
            </MenuItem>
            <MenuItem Header="_Claude">
                <MenuItem Header="Exportovat pro Clauda…" Click="Exportovat_Click" InputGestureText="Ctrl+E" />
                <MenuItem Header="Zkopírovat export na flash disk" Click="NaFlashDisk_Click" />
                <MenuItem x:Name="ZFlashDisku" AutomationProperties.AutomationId="ZFlashDisku" Header="Načíst výstupy od Clauda z flash disku…" Click="ZFlashDisku_Click" />
                <MenuItem Header="Vrátit jména do výstupu od Clauda…" Click="VratitJmena_Click" />
                <Separator />
                <MenuItem x:Name="ZaznamExportu" AutomationProperties.AutomationId="ZaznamExportu" Header="Záznam o exportech…" Click="ZaznamExportu_Click" IsEnabled="False"
                          ToolTip="Kdy a co ze spisu odešlo Claudovi, s počty nahrazených údajů. Doklad pro GDPR." />
            </MenuItem>
            <MenuItem Header="_Tisk a archiv">
                <MenuItem x:Name="TiskFotek" AutomationProperties.AutomationId="TiskFotek" Header="Upravené fotky k tisku…" Click="TiskFotek_Click" IsEnabled="False"
                          ToolTip="Fotky stran oříznuté na papír, narovnané a převedené na černobílé, do PDF k vytištění." />
                <MenuItem x:Name="PdfArchiv" AutomationProperties.AutomationId="PdfArchiv" Header="PDF pro archiv (s textem)…" Click="PdfArchiv_Click" IsEnabled="False"
                          ToolTip="Prohledatelné PDF spisu (fotky s textem) pro vlastní archiv. Obsahuje skutečné údaje, nedávat Claudovi." />
            </MenuItem>
        </Menu>
        <ToolBarTray DockPanel.Dock="Top" IsLocked="True">
            <ToolBar>
                <Button AutomationProperties.AutomationId="Novyspis" Content="Nový spis" Click="NovySpis_Click" ToolTip="Ctrl+N" Padding="8,4" />
                <Button x:Name="PridatFotky" AutomationProperties.AutomationId="PridatFotky" Content="Přidat fotky…" Click="PridatFotky_Click" Padding="8,4" IsEnabled="False"
                        ToolTip="Vybrané fotky nebo PDF (třeba z datové schránky). Černá fotka mezi fotkami odděluje dokumenty, každé PDF je samostatný dokument." />
                <Button x:Name="PridatSlozku" AutomationProperties.AutomationId="PridatSlozku" Content="Přidat složku…" Click="PridatSlozku_Click" Padding="8,4" IsEnabled="False"
                        ToolTip="Celá složka: každá podsložka je jeden dokument pojmenovaný podle ní. Černá fotka dokument dál dělí." />
                <Separator />
                <Button x:Name="SpustitPrepis" AutomationProperties.AutomationId="SpustitPrepis" Content="Spustit přepis" Click="SpustitPrepis_Click" Padding="8,4"
                        ToolTip="Narovná a přepíše všechny strany bez přepisu a najde v nich údaje. Může běžet přes noc, počítač mezitím neusne." />
                <Button x:Name="Zastavit" AutomationProperties.AutomationId="Zastavit" Content="Zastavit" Click="Zastavit_Click" Padding="8,4" IsEnabled="False" />
                <Separator />
                <TextBlock Text="Zvětšení" VerticalAlignment="Center" Margin="8,0,4,0" />
                <Slider x:Name="Zvetseni" AutomationProperties.AutomationId="Zvetseni" Minimum="0.1" Maximum="3" Value="0.5" Width="120" VerticalAlignment="Center"
                        ValueChanged="Zvetseni_ValueChanged" />
                <Button AutomationProperties.AutomationId="Nasirku" Content="Na šířku" Click="NaSirku_Click" Padding="8,4" />
                <Button AutomationProperties.AutomationId="Tlacitko" Content="⟲" Click="OtocitVlevo_Click" Padding="8,4" ToolTip="Otočit stranu doleva" />
                <Button AutomationProperties.AutomationId="Tlacitko" Content="⟳" Click="OtocitVpravo_Click" Padding="8,4" ToolTip="Otočit stranu doprava" />
            </ToolBar>
            <ToolBar>
                <Button x:Name="NajitUdaje" AutomationProperties.AutomationId="NajitUdaje" Content="Najít údaje" Click="NajitUdaje_Click" Padding="8,4" IsEnabled="False"
                        ToolTip="Projde všechny přepsané strany spisu a najde jména, adresy, čísla a další údaje." />
                <ToggleButton x:Name="Nahled" AutomationProperties.AutomationId="Nahled" Content="Náhled pro Clauda" Click="Nahled_Click" Padding="8,4"
                              ToolTip="Ukáže text strany tak, jak ho dostane Claude." />
                <CheckBox x:Name="Zkontrolovano" AutomationProperties.AutomationId="Zkontrolovano" Content="Strana zkontrolována" VerticalAlignment="Center" Margin="8,0"
                          Click="Zkontrolovano_Click" IsEnabled="False" />
                <Button x:Name="Exportovat" AutomationProperties.AutomationId="Exportovat" Content="Exportovat pro Clauda…" Click="Exportovat_Click" Padding="8,4" IsEnabled="False"
                        ToolTip="Celý spis nebo jen vybrané dokumenty (třeba nově doplněné). Ctrl+E" />
                <Separator />
                <Button x:Name="VratitJmena" AutomationProperties.AutomationId="VratitJmena" Content="Vrátit jména do výstupu od Clauda…" Click="VratitJmena_Click" Padding="8,4" IsEnabled="False"
                        ToolTip="Otevře dokument od Clauda, vrátí do něj skutečná jména a uloží ho jako Word." />
                <Button x:Name="NaFlashDisk" AutomationProperties.AutomationId="NaFlashDisk" Content="Na flash disk" Click="NaFlashDisk_Click" Padding="8,4"
                        ToolTip="Zkopíruje export pro Clauda na flash disk a ověří, že v něm nejsou fotky ani klíč." />
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <ProgressBar x:Name="Prubeh" AutomationProperties.AutomationId="Prubeh" Width="200" Height="14" Visibility="Collapsed" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="Stav" AutomationProperties.AutomationId="Stav" Text="Připraveno" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock>
                    <Run Background="#E1BEE7" Text=" údaj " />
                    <Run Text="  " /><Run Background="#FFE0B2" Text=" sporné čtení " />
                    <Run Text="  " /><Run Background="#C8E6C9" Text=" opraveno " />
                    <Run Text="   klik = místo na fotce, Shift+klik = více slov, dvojklik = oprava, pravé tlačítko = úpravy a anonymizace, Ctrl+tažení na fotce = doplnit vynechaný text" Foreground="Gray" />
                </TextBlock>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="3*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Spisy" FontWeight="SemiBold" Margin="6,6,6,2" />
                <ListBox x:Name="SeznamSpisu" AutomationProperties.AutomationId="SeznamSpisu" Grid.Row="1" SelectionChanged="SeznamSpisu_SelectionChanged" />
                <TextBlock Grid.Row="2" Text="Dokumenty a strany   (✓ přepsáno, ✎ opraveno, ☑ zkontrolováno, pravé tlačítko = přesuny)" FontWeight="SemiBold" Margin="6,8,6,2" TextWrapping="Wrap" />
                <ListBox x:Name="SeznamStran" AutomationProperties.AutomationId="SeznamStran" Grid.Row="3" SelectionChanged="SeznamStran_SelectionChanged">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="2,6,2,2" TextWrapping="Wrap" Foreground="#1F4E79" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Posunout stranu nahoru" Tag="-1" Click="PosunoutStranu_Click" />
                            <MenuItem Header="Posunout stranu dolů" Tag="1" Click="PosunoutStranu_Click" />
                            <MenuItem Header="Přesunout stranu do dokumentu…" Click="PresunoutDoDokumentu_Click" />
                            <Separator />
                            <MenuItem Header="Začít od této strany nový dokument" Click="ZacitDokument_Click" />
                            <MenuItem Header="Spojit dokument s předchozím" Click="SpojitDokument_Click" />
                            <Separator />
                            <MenuItem Header="Přejmenovat dokument…" Click="PrejmenovatDokument_Click" />
                            <MenuItem Header="Navrhnout název dokumentu z textu" Click="NavrhnoutNazev_Click" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </Grid>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />

            <TabControl x:Name="Zalozky" AutomationProperties.AutomationId="Zalozky" Grid.Column="2" SelectionChanged="Zalozky_SelectionChanged">
                <TabItem Header="Text strany">
                    <FlowDocumentScrollViewer x:Name="TextStrany" AutomationProperties.AutomationId="TextStrany" VerticalScrollBarVisibility="Auto">
                        <FlowDocumentScrollViewer.ContextMenu>
                            <ContextMenu x:Name="MenuSlova" AutomationProperties.AutomationId="MenuSlova">
                                <MenuItem Header="Anonymizovat jako osobu" Tag="Osoba" Click="OznacitJako_Click" />
                                <MenuItem Header="Anonymizovat jako firmu" Tag="Firma" Click="OznacitJako_Click" />
                                <MenuItem Header="Anonymizovat jako adresu" Tag="Adresa" Click="OznacitJako_Click" />
                                <MenuItem Header="Anonymizovat jako nemovitost" Tag="Nemovitost" Click="OznacitJako_Click" />
                                <MenuItem Header="Anonymizovat jako spisovou značku" Tag="SpisovaZnacka" Click="OznacitJako_Click" />
                                <MenuItem Header="Odstranit (jiný citlivý údaj)" Tag="Jiny" Click="OznacitJako_Click" />
                                <Separator />
                                <MenuItem Header="Není citlivé" Click="Necitlive_Click" />
                                <Separator />
                                <MenuItem Header="Opravit slovo…" Click="OpravitSlovo_Click" />
                                <MenuItem Header="Doplnit vynechaný text za toto slovo…" Click="DoplnitZa_Click" />
                                <MenuItem Header="Smazat vybraná slova" Click="SmazatSlova_Click" />
                                <Separator />
                                <MenuItem Header="Zalomit řádek před tímto slovem" Click="Zalomit_Click" />
                                <MenuItem Header="Spojit řádek s dalším" Click="Spojit_Click" />
                                <MenuItem Header="Posunout řádek nahoru" Tag="-1" Click="PosunoutRadek_Click" />
                                <MenuItem Header="Posunout řádek dolů" Tag="1" Click="PosunoutRadek_Click" />
                            </ContextMenu>
                        </FlowDocumentScrollViewer.ContextMenu>
                        <FlowDocument FontFamily="Segoe UI" FontSize="15" PagePadding="16" />
                    </FlowDocumentScrollViewer>
                </TabItem>
                <TabItem Header="Osoby a údaje">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top" Margin="4">
                            <Button AutomationProperties.AutomationId="Nahradit" Content="Nahradit" Click="UdajPseudonym_Click" Padding="8,3" Margin="2" ToolTip="Údaj se v textu pro Clauda nahradí." />
                            <Button AutomationProperties.AutomationId="Odstranit" Content="Odstranit" Click="UdajOdstranit_Click" Padding="8,3" Margin="2" ToolTip="Údaj se z textu úplně vypustí." />
                            <Button AutomationProperties.AutomationId="Tohleneanonymizovat" Content="Tohle neanonymizovat" Click="UdajPonechat_Click" Padding="8,3" Margin="2"
                                    ToolTip="Údaj zůstane v textu pro Clauda tak, jak je ve spisu (soud, úřad, obec…)." />
                            <Button AutomationProperties.AutomationId="Jinevymyslenejmeno" Content="Jiné vymyšlené jméno" Click="UdajNoveJmeno_Click" Padding="8,3" Margin="2" />
                            <Button AutomationProperties.AutomationId="Smazat" Content="Smazat" Click="UdajSmazat_Click" Padding="8,3" Margin="2" ToolTip="Údaj není citlivý ani nesouvisí, odebrat z klíče." />
                            <TextBlock Text="Osoby nahrazovat:" VerticalAlignment="Center" Margin="12,0,4,0" />
                            <ComboBox x:Name="StylOsob" AutomationProperties.AutomationId="StylOsob" Width="200" SelectionChanged="StylOsob_SelectionChanged">
                                <ComboBoxItem Content="vymyšlenými jmény (stromy)" Tag="Stromy" />
                                <ComboBoxItem Content="vymyšlenými jmény (zvířata)" Tag="Zvirata" />
                                <ComboBoxItem Content="kódy [OSOBA_001]" Tag="Kody" />
                            </ComboBox>
                            <Button AutomationProperties.AutomationId="Prevzitzjinehospisu" Content="Převzít z jiného spisu…" Click="Prevzit_Click" Padding="8,3" Margin="8,2,2,2"
                                    ToolTip="Stejné osoby dostanou stejná vymyšlená jména jako v jiném spisu." />
                        </WrapPanel>
                        <TextBlock DockPanel.Dock="Bottom" Margin="6" Foreground="Gray" TextWrapping="Wrap"
                                   Text="Skutečné jméno, náhradu a roli jde přepsat dvojklikem. Skutečné jméno v 1. pádě se vrací do dokumentů od Clauda, proto ho oprav, pokud ho OCR přečetlo chybně. Odsazené řádky patří k osobě nad nimi." />
                        <DataGrid x:Name="TabulkaUdaju" AutomationProperties.AutomationId="TabulkaUdaju" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column" SelectionMode="Extended" GridLinesVisibility="Horizontal"
                                  CellEditEnding="TabulkaUdaju_CellEditEnding" RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Údaj" Binding="{Binding Udaj, Mode=OneWay}" IsReadOnly="True" Width="Auto" />
                                <DataGridTextColumn Header="Skutečnost" Binding="{Binding Skutecnost}" Width="2*" />
                                <DataGridTextColumn Header="Pro Clauda" Binding="{Binding Nahrada}" Width="2*" />
                                <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="*" />
                                <DataGridTextColumn Header="Akce" Binding="{Binding AkceText, Mode=OneWay}" IsReadOnly="True" Width="Auto" />
                                <DataGridCheckBoxColumn Header="Iniciály" Binding="{Binding Inicialy, UpdateSourceTrigger=PropertyChanged}" Width="Auto" />
                                <DataGridTextColumn Header="Tvary v textu" Binding="{Binding Tvary, Mode=OneWay}" IsReadOnly="True" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Rychlá kontrola" AutomationProperties.AutomationId="ZalozkaRychlaKontrola" x:Name="ZalozkaRk">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top" Margin="4">
                            <TextBlock x:Name="RkSouhrn" AutomationProperties.AutomationId="RkSouhrn" VerticalAlignment="Center" Margin="4,0,12,0" TextWrapping="Wrap" MaxWidth="520" />
                            <Button Content="Načíst znovu" Click="RkNacist_Click" Padding="8,3" Margin="0,0,6,0" />
                        </WrapPanel>
                        <Border DockPanel.Dock="Bottom" BorderBrush="LightGray" BorderThickness="0,1,0,0" Padding="8">
                            <StackPanel>
                                <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6">
                                    <TextBlock x:Name="RkKontext" AutomationProperties.AutomationId="RkKontext" FontSize="16" TextWrapping="Wrap" />
                                </ScrollViewer>
                                <Image x:Name="RkVyrez" Height="140" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,6" />
                                <WrapPanel>
                                    <Button x:Name="RkOk" AutomationProperties.AutomationId="RkOk" Content="V pořádku (Enter)" Click="RkOk_Click" Padding="8,3" Margin="0,0,6,4" />
                                    <Button x:Name="RkNecitlive" AutomationProperties.AutomationId="RkNecitlive" Content="Není citlivé (N)" Click="RkNecitlive_Click" Padding="8,3" Margin="0,0,6,4"
                                            ToolTip="Nahrazený údaj nechat v textu pro Clauda (soud, úřad…), podezřelé slovo už nehlásit." />
                                    <Button x:Name="RkOsoba" AutomationProperties.AutomationId="RkOsoba" Content="Je to osoba (O)" Tag="Osoba" Click="RkOznacit_Click" Padding="8,3" Margin="0,0,6,4" />
                                    <Button x:Name="RkJiny" AutomationProperties.AutomationId="RkJiny" Content="Jiný údaj, odstranit (U)" Tag="Jiny" Click="RkOznacit_Click" Padding="8,3" Margin="0,0,6,4" />
                                    <Button Content="Otevřít stranu" Click="RkOtevrit_Click" Padding="8,3" Margin="0,0,6,4" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <ListBox x:Name="RkSeznam" AutomationProperties.AutomationId="RkSeznam" SelectionChanged="RkSeznam_SelectionChanged"
                                 PreviewKeyDown="RkSeznam_PreviewKeyDown" FontSize="14" />
                    </DockPanel>
                </TabItem>
                <TabItem Header="Hledání" AutomationProperties.AutomationId="ZalozkaHledani">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="4">
                            <Button DockPanel.Dock="Right" Content="Hledat" Click="Hledat_Click" Padding="10,3" Margin="6,0,0,0" />
                            <TextBox x:Name="HledatPole" AutomationProperties.AutomationId="HledatPole" FontSize="15" KeyDown="HledatPole_KeyDown"
                                     ToolTip="Slovo nebo frázi ve všech stranách spisu. Nezáleží na diakritice, začátek slova najde i jiné tvary. Ctrl+F" />
                        </DockPanel>
                        <TextBlock x:Name="HledatSouhrn" AutomationProperties.AutomationId="HledatSouhrn" DockPanel.Dock="Top" Margin="8,0,8,4" Foreground="Gray" />
                        <ListBox x:Name="HledatVysledky" AutomationProperties.AutomationId="HledatVysledky" FontSize="14"
                                 MouseDoubleClick="HledatVysledky_Otevrit" KeyDown="HledatVysledky_Otevrit" />
                    </DockPanel>
                </TabItem>
                <TabItem Header="Data" AutomationProperties.AutomationId="ZalozkaData">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top" Margin="4">
                            <Button Content="Načíst znovu" Click="DataNacist_Click" Padding="8,3" Margin="0,0,6,0" />
                            <CheckBox x:Name="DataBezNarozeni" AutomationProperties.AutomationId="DataBezNarozeni" Content="Skrýt data narození" IsChecked="True"
                                      VerticalAlignment="Center" Margin="0,0,12,0" Click="DataNacist_Click" />
                            <Button Content="Uložit jako Word…" Click="DataUlozit_Click" Padding="8,3"
                                    ToolTip="Přehled dat pro vlastní potřebu. Obsahuje skutečné údaje, nedávat Claudovi." />
                        </WrapPanel>
                        <TextBlock x:Name="DataSouhrn" AutomationProperties.AutomationId="DataSouhrn" DockPanel.Dock="Top" Margin="8,0,8,4" Foreground="Gray" TextWrapping="Wrap" />
                        <ListBox x:Name="DataSeznam" AutomationProperties.AutomationId="DataSeznam" FontSize="14"
                                 MouseDoubleClick="DataSeznam_Otevrit" KeyDown="DataSeznam_Otevrit" />
                    </DockPanel>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" />

            <ScrollViewer x:Name="FotkaScroll" AutomationProperties.AutomationId="FotkaScroll" Grid.Column="4" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto" Background="#F0F0F0"
                          PreviewMouseWheel="FotkaScroll_PreviewMouseWheel">
                <Grid x:Name="Platno" AutomationProperties.AutomationId="Platno" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid.LayoutTransform>
                        <ScaleTransform x:Name="Meritko" AutomationProperties.AutomationId="Meritko" ScaleX="0.5" ScaleY="0.5" />
                    </Grid.LayoutTransform>
                    <Image x:Name="Fotka" AutomationProperties.AutomationId="Fotka" Stretch="Fill" Cursor="Hand"
                           MouseLeftButtonDown="Fotka_MouseLeftButtonDown" MouseMove="Fotka_MouseMove"
                           MouseLeftButtonUp="Fotka_MouseLeftButtonUp" />
                    <Canvas x:Name="Vrstva" AutomationProperties.AutomationId="Vrstva" IsHitTestVisible="False" />
                </Grid>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
