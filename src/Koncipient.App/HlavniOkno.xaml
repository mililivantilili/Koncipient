<Window x:Class="Koncipient.App.HlavniOkno"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Koncipient" Height="850" Width="1400" WindowState="Maximized"
        FontFamily="Segoe UI" FontSize="13" PreviewKeyDown="Okno_PreviewKeyDown">
    <Window.Resources>
        <!-- velké tlačítko pásu karet: ikona z písma Segoe (Tag) a popisek pod ní -->
        <Style x:Key="Velke" TargetType="ButtonBase">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="MaxWidth" Value="100" />
            <Setter Property="Margin" Value="1,0" />
            <!-- barva ikony: modrá pro běžné akce, zelená spustit, červená zastavit, oranžová pro to, co jde ke Claudovi -->
            <Setter Property="Foreground" Value="#2B579A" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Pozadi" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="6,4">
                            <StackPanel>
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22"
                                           HorizontalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                                <ContentPresenter HorizontalAlignment="Center" Margin="0,4,0,0">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                            <Setter Property="TextAlignment" Value="Center" />
                                            <Setter Property="FontSize" Value="12" />
                                            <Setter Property="Foreground" Value="#262626" />
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pozadi" Property="Background" Value="#E3ECF8" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Pozadi" Property="BorderBrush" Value="#2B579A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Pozadi" Property="Background" Value="#C9DAF0" />
                            </Trigger>
                            <Trigger Property="ToggleButton.IsChecked" Value="True">
                                <Setter TargetName="Pozadi" Property="Background" Value="#C9DAF0" />
                                <Setter TargetName="Pozadi" Property="BorderBrush" Value="#8FB0DB" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Skupina" TargetType="DockPanel">
            <Setter Property="Margin" Value="4,2,4,0" />
            <!-- stejná výška na všech kartách, aby obsah okna při přepínání neposkakoval -->
            <Setter Property="MinHeight" Value="98" />
            <Setter Property="LastChildFill" Value="True" />
        </Style>
        <Style x:Key="NazevSkupiny" TargetType="TextBlock">
            <Setter Property="DockPanel.Dock" Value="Bottom" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,2,0,2" />
        </Style>
        <Style x:Key="Oddelovac" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Fill" Value="#D6DCE5" />
            <Setter Property="Margin" Value="2,6,2,6" />
        </Style>
        <!-- záhlaví karet: jen text, vybraná karta podtržená modře -->
        <Style x:Key="Karta" TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Karta" Padding="16,6,16,5" Margin="0,0,2,0" Background="Transparent" BorderThickness="0,0,0,3" BorderBrush="Transparent" Cursor="Hand">
                            <ContentPresenter x:Name="Zahlavi" ContentSource="Header" TextBlock.FontSize="13" TextBlock.Foreground="#333" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Karta" Property="Background" Value="#E3ECF8" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Karta" Property="BorderBrush" Value="#2B579A" />
                                <!-- tučné jen záhlaví, obsah karty (text strany) zůstává obyčejný -->
                                <Setter TargetName="Zahlavi" Property="TextBlock.FontWeight" Value="SemiBold" />
                                <Setter TargetName="Zahlavi" Property="TextBlock.Foreground" Value="#1F3F75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <!-- Pás karet jako ve Wordu: karty podle kroků práce, ve skupinách velká tlačítka s ikonou -->
        <TabControl x:Name="Pas" AutomationProperties.AutomationId="PasKaret" DockPanel.Dock="Top" Background="#F5F7FB" BorderThickness="0,0,0,1" BorderBrush="#D6DCE5" Padding="2"
                    ItemContainerStyle="{StaticResource Karta}">
            <TabItem Header="Domů" AutomationProperties.AutomationId="KartaDomu">
                <StackPanel Orientation="Horizontal">
                    <DockPanel Style="{StaticResource Skupina}">
                        <TextBlock Style="{StaticResource NazevSkupiny}" Text="Spis" />
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Velke}" Tag="&#xE8A5;" Content="Nový spis" Click="NovySpis_Click" AutomationProperties.AutomationId="Novyspis" ToolTip="Ctrl+N" />
                            <Button x:Name="PridatFotky" Style="{StaticResource Velke}" Tag="&#xE722;" Content="Přidat fotky" Click="PridatFotky_Click" IsEnabled="False" AutomationProperties.AutomationId="PridatFotky"
                                    ToolTip="Vybrané fotky nebo PDF (třeba z datové schránky). Černá fotka mezi fotkami odděluje dokumenty. Ctrl+O" />
                            <Button x:Name="PridatSlozku" Style="{StaticResource Velke}" Tag="&#xE8B7;" Content="Přidat složku" Click="PridatSlozku_Click" IsEnabled="False" AutomationProperties.AutomationId="PridatSlozku"
                                    ToolTip="Celá složka: každá podsložka je jeden dokument pojmenovaný podle ní. Ctrl+Shift+O" />
                        </StackPanel>
                    </DockPanel>
                    <Rectangle Style="{StaticResource Oddelovac}" />
                    <DockPanel Style="{StaticResource Skupina}">
                        <TextBlock Style="{StaticResource NazevSkupiny}" Text="Přepis" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="SpustitPrepis" Style="{StaticResource Velke}" Tag="&#xE768;" Foreground="#107C10" Content="Spustit přepis" Click="SpustitPrepis_Click" AutomationProperties.AutomationId="SpustitPrepis"
                                    ToolTip="Narovná a přepíše všechny strany bez přepisu a najde v nich údaje. Může běžet přes noc, počítač mezitím neusne. F5" />
                            <Button x:Name="Zastavit" Style="{StaticResource Velke}" Tag="&#xE71A;" Foreground="#C42B1C" Content="Zastavit" Click="Zastavit_Click" IsEnabled="False" AutomationProperties.AutomationId="Zastavit" />
                        </StackPanel>
                    </DockPanel>
                    <Rectangle Style="{StaticResource Oddelovac}" />
                    <DockPanel Style="{StaticResource Skupina}">
                        <TextBlock Style="{StaticResource NazevSkupiny}" Text="Zobrazení" />
                        <StackPanel Orientation="Horizontal">
                            <StackPanel VerticalAlignment="Center" Margin="6,0,8,0">
                                <TextBlock Text="Zvětšení" Foreground="#262626" FontSize="12" Margin="2,0,0,4" />
                                <Slider x:Name="Zvetseni" AutomationProperties.AutomationId="Zvetseni" Minimum="0.1" Maximum="3" Value="0.5" Width="110" ValueChanged="Zvetseni_ValueChanged" />
                            </StackPanel>
                            <Button Style="{StaticResource Velke}" Tag="&#xE9A6;" Content="Na šířku" Click="NaSirku_Click" AutomationProperties.AutomationId="Nasirku" />
                            <Button Style="{StaticResource Velke}" Tag="&#xE7A7;" Content="Otočit doleva" Click="OtocitVlevo_Click" AutomationProperties.AutomationId="OtocitVlevo" />
                            <Button Style="{StaticResource Velke}" Tag="&#xE7A6;" Content="Otočit doprava" Click="OtocitVpravo_Click" AutomationProperties.AutomationId="OtocitVpravo" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </TabItem>
            <TabItem Header="Kontrola" AutomationProperties.AutomationId="KartaKontrola">
                <StackPanel Orientation="Horizontal">
                    <DockPanel Style="{StaticResource Skupina}">
                        <TextBlock Style="{StaticResource NazevSkupiny}" Text="Údaje" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="NajitUdaje" Style="{StaticResource Velke}" Tag="&#xE8EC;" Content="Najít údaje" Click="NajitUdaje_Click" IsEnabled="False" AutomationProperties.AutomationId="NajitUdaje"
                                    ToolTip="Projde všechny přepsané strany spisu a najde jména, adresy, čísla a další údaje." />
                            <Button Style="{StaticResource Velke}" Tag="&#xE77B;" Content="Osoby a údaje" Click="PasOsoby_Click" AutomationProperties.AutomationId="PasOsoby" />
                            <Button Style="{StaticResource Velke}" Tag="&#xE73E;" Content="Rychlá kontrola" Click="PasRychlaKontrola_Click" AutomationProperties.AutomationId="PasRychlaKontrola"
                                    ToolTip="Projde nalezená místa a pak celé strany tak, jak je dostane Claude." />
                        </StackPanel>
                    </DockPanel>
                    <Rectangle Style="{StaticResource Oddelovac}" />
                    <DockPanel Style="{StaticResource Skupina}">
                        <TextBlock Style="{StaticResource NazevSkupiny}" Text="Strana" />
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="Nahled" Style="{StaticResource Velke}" Tag="&#xE890;" Content="Náhled pro Clauda" Click="Nahled_Click" AutomationProperties.AutomationId="Nahled"
                                          ToolTip="Ukáže text strany tak, jak ho dostane Claude." />
                            <ToggleButton x:Name="Zkontrolovano" Style="{StaticResource Velke}" Tag="&#xE930;" Foreground="#107C10" Content="Strana zkontrolována" Click="Zkontrolovano_Click" IsEnabled="False"
                                          AutomationProperties.AutomationId="Zkontrolovano" ToolTip="Ctrl+K" />
                        </StackPanel>
                    </DockPanel>
                    <Rectangle Style="{StaticResource Oddelovac}" />
                    <DockPanel Style="{StaticResource Skupina}">
                        <TextBlock Style="{StaticResource NazevSkupiny}" Text="Spis" />
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Velke}" Tag="&#xE721;" Content="Hledat" Click="PasHledat_Click" AutomationProperties.AutomationId="PasHledat" ToolTip="Ctrl+F" />
                            <Button Style="{StaticResource Velke}" Tag="&#xE787;" Content="Data ve spisu" Click="PasData_Click" AutomationProperties.AutomationId="PasData" />
                            <Button x:Name="KPrefoceni" Style="{StaticResource Velke}" Tag="&#xE72C;" Foreground="#B9690B" Content="K přefocení" Click="KPrefoceni_Click" AutomationProperties.AutomationId="KPrefoceni"
                                    ToolTip="Strany, které vyšly špatně (rozmazané, tmavé, uříznuté), s možností nahradit je novou fotkou." />
                            <Button x:Name="Oddelovace" Style="{StaticResource Velke}" Tag="&#xE8C6;" Content="Oddělovače" Click="Oddelovace_Click" IsEnabled="False" AutomationProperties.AutomationId="Oddelovace"
                                    ToolTip="Fotky vzaté jako oddělovače dokumentů (zakrytý objektiv). Skutečnou stránku jde vrátit mezi strany." />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </TabItem>
            <TabItem Header="Claude" AutomationProperties.AutomationId="KartaClaude">
                <StackPanel Orientation="Horizontal">
                    <DockPanel Style="{StaticResource Skupina}">
                        <TextBlock Style="{StaticResource NazevSkupiny}" Text="Pro Clauda" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="Exportovat" Style="{StaticResource Velke}" Tag="&#xE72D;" Foreground="#C15F3C" Content="Exportovat" Click="Exportovat_Click" IsEnabled="False" AutomationProperties.AutomationId="Exportovat"
                                    ToolTip="Celý spis nebo jen vybrané dokumenty, s úkolem pro Clauda. Ctrl+E" />
                            <Button x:Name="NaFlashDisk" Style="{StaticResource Velke}" Tag="&#xE88E;" Foreground="#C15F3C" Content="Na flash disk" Click="NaFlashDisk_Click" AutomationProperties.AutomationId="NaFlashDisk"
                                    ToolTip="Zkopíruje export pro Clauda na flash disk a ověří, že v něm nejsou fotky ani klíč." />
                        </StackPanel>
                    </DockPanel>
                    <Rectangle Style="{StaticResource Oddelovac}" />
                    <DockPanel Style="{StaticResource Skupina}">
                        <TextBlock Style="{StaticResource NazevSkupiny}" Text="Od Clauda" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ZFlashDisku" Style="{StaticResource Velke}" Tag="&#xE896;" Content="Načíst z flash disku" Click="ZFlashDisku_Click" AutomationProperties.AutomationId="ZFlashDisku"
                                    ToolTip="Načte z flash disku nové výstupy od Clauda a otevře je k vrácení jmen." />
                            <Button x:Name="VratitJmena" Style="{StaticResource Velke}" Tag="&#xE8AB;" Content="Vrátit jména" Click="VratitJmena_Click" IsEnabled="False" AutomationProperties.AutomationId="VratitJmena"
                                    ToolTip="Otevře dokument od Clauda, vrátí do něj skutečná jména a uloží ho jako Word." />
                        </StackPanel>
                    </DockPanel>
                    <Rectangle Style="{StaticResource Oddelovac}" />
                    <DockPanel Style="{StaticResource Skupina}">
                        <TextBlock Style="{StaticResource NazevSkupiny}" Text="Doklad" />
                        <Button x:Name="ZaznamExportu" Style="{StaticResource Velke}" Tag="&#xE81C;" Content="Záznam o exportech" Click="ZaznamExportu_Click" IsEnabled="False" AutomationProperties.AutomationId="ZaznamExportu"
                                ToolTip="Kdy a co ze spisu odešlo Claudovi, s počty nahrazených údajů. Doklad pro GDPR." />
                    </DockPanel>
                </StackPanel>
            </TabItem>
            <TabItem Header="Tisk a archiv" AutomationProperties.AutomationId="KartaTisk">
                <StackPanel Orientation="Horizontal">
                    <DockPanel Style="{StaticResource Skupina}">
                        <TextBlock Style="{StaticResource NazevSkupiny}" Text="Tisk" />
                        <Button x:Name="TiskFotek" Style="{StaticResource Velke}" Tag="&#xE749;" Content="Fotky k tisku" Click="TiskFotek_Click" IsEnabled="False" AutomationProperties.AutomationId="TiskFotek"
                                ToolTip="Fotky stran oříznuté na papír, narovnané a převedené na černobílé, do PDF k vytištění." />
                    </DockPanel>
                    <Rectangle Style="{StaticResource Oddelovac}" />
                    <DockPanel Style="{StaticResource Skupina}">
                        <TextBlock Style="{StaticResource NazevSkupiny}" Text="Archiv" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="PdfArchiv" Style="{StaticResource Velke}" Tag="&#xEA90;" Content="PDF s textem" Click="PdfArchiv_Click" IsEnabled="False" AutomationProperties.AutomationId="PdfArchiv"
                                    ToolTip="Prohledatelné PDF spisu (fotky s textem) pro vlastní archiv. Obsahuje skutečné údaje, nedávat Claudovi." />
                            <Button x:Name="Zalohovat" Style="{StaticResource Velke}" Tag="&#xE74E;" Content="Zálohovat spisy" Click="Zalohovat_Click" AutomationProperties.AutomationId="Zalohovat"
                                    ToolTip="Zkopíruje všechny spisy na externí disk, který zůstává u spisů, a ověří kopii." />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </TabItem>
        </TabControl>
        <!-- Průvodce spisem: kde spis je a co dál -->
        <Border x:Name="Pruvodce" AutomationProperties.AutomationId="Pruvodce" DockPanel.Dock="Top" Background="White" BorderBrush="#D6DCE5" BorderThickness="0,0,0,1"
                Padding="10,6" Visibility="Collapsed">
            <DockPanel>
                <Button x:Name="PruvodceDalsi" AutomationProperties.AutomationId="PruvodceDalsi" DockPanel.Dock="Right" Click="PruvodceDalsi_Click" Cursor="Hand"
                        Padding="14,5" Background="#2B579A" Foreground="White" BorderThickness="0" FontWeight="SemiBold" ToolTip="Doporučený další krok" />
                <StackPanel x:Name="PruvodceKroky" Orientation="Horizontal" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <ProgressBar x:Name="Prubeh" AutomationProperties.AutomationId="Prubeh" Width="200" Height="14" Visibility="Collapsed" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="Stav" AutomationProperties.AutomationId="Stav" Text="Připraveno" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock>
                    <Run Background="#E1BEE7" Text=" údaj " />
                    <Run Text="  " /><Run Background="#FFE0B2" Text=" sporné čtení " />
                    <Run Text="  " /><Run Background="#C8E6C9" Text=" opraveno " />
                    <Run Text="   klik = místo na fotce, Shift+klik = více slov, dvojklik = oprava, pravé tlačítko = úpravy a anonymizace, Ctrl+tažení na fotce = doplnit vynechaný text" Foreground="Gray" />
                </TextBlock>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="3*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Spisy" FontWeight="SemiBold" Margin="6,6,6,2" />
                <ListBox x:Name="SeznamSpisu" AutomationProperties.AutomationId="SeznamSpisu" Grid.Row="1" SelectionChanged="SeznamSpisu_SelectionChanged" />
                <StackPanel Grid.Row="2" Margin="6,8,6,2">
                    <TextBlock Text="Dokumenty a strany" FontWeight="SemiBold" />
                    <TextBlock FontSize="11" Foreground="#555" TextWrapping="Wrap">
                        <Run Text="●" Foreground="#A0A7B1" /> nepřepsaná  <Run Text="●" Foreground="#E8912D" /> ke kontrole
                        <Run Text="●" Foreground="#2E9E4F" /> zkontrolovaná  <Run Text="●" Foreground="#D13438" /> přefotit · pravé tlačítko = přesuny
                    </TextBlock>
                </StackPanel>
                <ListBox x:Name="SeznamStran" AutomationProperties.AutomationId="SeznamStran" Grid.Row="3" SelectionChanged="SeznamStran_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" ToolTip="{Binding StavText}">
                                <Ellipse Width="9" Height="9" Fill="{Binding Barva}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Popis}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="2,6,2,2" TextWrapping="Wrap" Foreground="#1F4E79" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Posunout stranu nahoru" Tag="-1" Click="PosunoutStranu_Click" />
                            <MenuItem Header="Posunout stranu dolů" Tag="1" Click="PosunoutStranu_Click" />
                            <MenuItem Header="Přesunout stranu do dokumentu…" Click="PresunoutDoDokumentu_Click" />
                            <Separator />
                            <MenuItem Header="Začít od této strany nový dokument" Click="ZacitDokument_Click" />
                            <MenuItem Header="Spojit dokument s předchozím" Click="SpojitDokument_Click" />
                            <Separator />
                            <MenuItem Header="Přejmenovat dokument…" Click="PrejmenovatDokument_Click" />
                            <MenuItem Header="Navrhnout název dokumentu z textu" Click="NavrhnoutNazev_Click" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </Grid>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />

            <TabControl x:Name="Zalozky" AutomationProperties.AutomationId="Zalozky" Grid.Column="2" SelectionChanged="Zalozky_SelectionChanged"
                        ItemContainerStyle="{StaticResource Karta}" BorderThickness="0,1,0,0" BorderBrush="#D6DCE5" Padding="0">
                <TabItem Header="Text strany">
                    <FlowDocumentScrollViewer x:Name="TextStrany" AutomationProperties.AutomationId="TextStrany" VerticalScrollBarVisibility="Auto">
                        <FlowDocumentScrollViewer.ContextMenu>
                            <ContextMenu x:Name="MenuSlova" AutomationProperties.AutomationId="MenuSlova">
                                <MenuItem Header="Anonymizovat jako osobu" Tag="Osoba" Click="OznacitJako_Click" />
                                <MenuItem Header="Anonymizovat jako firmu" Tag="Firma" Click="OznacitJako_Click" />
                                <MenuItem Header="Anonymizovat jako adresu" Tag="Adresa" Click="OznacitJako_Click" />
                                <MenuItem Header="Anonymizovat jako nemovitost" Tag="Nemovitost" Click="OznacitJako_Click" />
                                <MenuItem Header="Anonymizovat jako spisovou značku" Tag="SpisovaZnacka" Click="OznacitJako_Click" />
                                <MenuItem Header="Odstranit (jiný citlivý údaj)" Tag="Jiny" Click="OznacitJako_Click" />
                                <Separator />
                                <MenuItem Header="Není citlivé" Click="Necitlive_Click" />
                                <Separator />
                                <MenuItem Header="Opravit slovo…" Click="OpravitSlovo_Click" />
                                <MenuItem Header="Doplnit vynechaný text za toto slovo…" Click="DoplnitZa_Click" />
                                <MenuItem Header="Smazat vybraná slova" Click="SmazatSlova_Click" />
                                <Separator />
                                <MenuItem Header="Zalomit řádek před tímto slovem" Click="Zalomit_Click" />
                                <MenuItem Header="Spojit řádek s dalším" Click="Spojit_Click" />
                                <MenuItem Header="Posunout řádek nahoru" Tag="-1" Click="PosunoutRadek_Click" />
                                <MenuItem Header="Posunout řádek dolů" Tag="1" Click="PosunoutRadek_Click" />
                            </ContextMenu>
                        </FlowDocumentScrollViewer.ContextMenu>
                        <FlowDocument FontFamily="Segoe UI" FontSize="15" PagePadding="16" />
                    </FlowDocumentScrollViewer>
                </TabItem>
                <TabItem Header="Osoby a údaje">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top" Margin="4">
                            <Button AutomationProperties.AutomationId="Nahradit" Content="Nahradit" Click="UdajPseudonym_Click" Padding="8,3" Margin="2" ToolTip="Údaj se v textu pro Clauda nahradí." />
                            <Button AutomationProperties.AutomationId="Odstranit" Content="Odstranit" Click="UdajOdstranit_Click" Padding="8,3" Margin="2" ToolTip="Údaj se z textu úplně vypustí." />
                            <Button AutomationProperties.AutomationId="Tohleneanonymizovat" Content="Tohle neanonymizovat" Click="UdajPonechat_Click" Padding="8,3" Margin="2"
                                    ToolTip="Údaj zůstane v textu pro Clauda tak, jak je ve spisu (soud, úřad, obec…)." />
                            <Button AutomationProperties.AutomationId="Jinevymyslenejmeno" Content="Jiné vymyšlené jméno" Click="UdajNoveJmeno_Click" Padding="8,3" Margin="2" />
                            <Button AutomationProperties.AutomationId="Smazat" Content="Smazat" Click="UdajSmazat_Click" Padding="8,3" Margin="2" ToolTip="Údaj není citlivý ani nesouvisí, odebrat z klíče." />
                            <TextBlock Text="Osoby nahrazovat:" VerticalAlignment="Center" Margin="12,0,4,0" />
                            <ComboBox x:Name="StylOsob" AutomationProperties.AutomationId="StylOsob" Width="200" SelectionChanged="StylOsob_SelectionChanged">
                                <ComboBoxItem Content="vymyšlenými jmény (stromy)" Tag="Stromy" />
                                <ComboBoxItem Content="vymyšlenými jmény (zvířata)" Tag="Zvirata" />
                                <ComboBoxItem Content="kódy [OSOBA_001]" Tag="Kody" />
                            </ComboBox>
                            <Button AutomationProperties.AutomationId="Prevzitzjinehospisu" Content="Převzít z jiného spisu…" Click="Prevzit_Click" Padding="8,3" Margin="8,2,2,2"
                                    ToolTip="Stejné osoby dostanou stejná vymyšlená jména jako v jiném spisu." />
                        </WrapPanel>
                        <TextBlock DockPanel.Dock="Bottom" Margin="6" Foreground="Gray" TextWrapping="Wrap"
                                   Text="Skutečné jméno, náhradu a roli jde přepsat dvojklikem. Skutečné jméno v 1. pádě se vrací do dokumentů od Clauda, proto ho oprav, pokud ho OCR přečetlo chybně. Odsazené řádky patří k osobě nad nimi." />
                        <DataGrid x:Name="TabulkaUdaju" AutomationProperties.AutomationId="TabulkaUdaju" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column" SelectionMode="Extended" GridLinesVisibility="Horizontal"
                                  CellEditEnding="TabulkaUdaju_CellEditEnding" RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Údaj" Binding="{Binding Udaj, Mode=OneWay}" IsReadOnly="True" Width="Auto" />
                                <DataGridTextColumn Header="Skutečnost" Binding="{Binding Skutecnost}" Width="2*" />
                                <DataGridTextColumn Header="Pro Clauda" Binding="{Binding Nahrada}" Width="2*" />
                                <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="*" />
                                <DataGridTextColumn Header="Akce" Binding="{Binding AkceText, Mode=OneWay}" IsReadOnly="True" Width="Auto" />
                                <DataGridCheckBoxColumn Header="Iniciály" Binding="{Binding Inicialy, UpdateSourceTrigger=PropertyChanged}" Width="Auto" />
                                <DataGridTextColumn Header="Tvary v textu" Binding="{Binding Tvary, Mode=OneWay}" IsReadOnly="True" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Rychlá kontrola" AutomationProperties.AutomationId="ZalozkaRychlaKontrola" x:Name="ZalozkaRk">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top" Margin="4">
                            <TextBlock x:Name="RkSouhrn" AutomationProperties.AutomationId="RkSouhrn" VerticalAlignment="Center" Margin="4,0,12,0" TextWrapping="Wrap" MaxWidth="520" />
                            <Button Content="Načíst znovu" Click="RkNacist_Click" Padding="8,3" Margin="0,0,6,0" />
                        </WrapPanel>
                        <Border DockPanel.Dock="Bottom" BorderBrush="LightGray" BorderThickness="0,1,0,0" Padding="8">
                            <StackPanel>
                                <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6">
                                    <TextBlock x:Name="RkKontext" AutomationProperties.AutomationId="RkKontext" FontSize="16" TextWrapping="Wrap" />
                                </ScrollViewer>
                                <Image x:Name="RkVyrez" Height="140" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,6" />
                                <WrapPanel>
                                    <Button x:Name="RkOk" AutomationProperties.AutomationId="RkOk" Content="V pořádku (Enter)" Click="RkOk_Click" Padding="8,3" Margin="0,0,6,4" />
                                    <Button x:Name="RkNecitlive" AutomationProperties.AutomationId="RkNecitlive" Content="Není citlivé (N)" Click="RkNecitlive_Click" Padding="8,3" Margin="0,0,6,4"
                                            ToolTip="Nahrazený údaj nechat v textu pro Clauda (soud, úřad…), podezřelé slovo už nehlásit." />
                                    <Button x:Name="RkOsoba" AutomationProperties.AutomationId="RkOsoba" Content="Je to osoba (O)" Tag="Osoba" Click="RkOznacit_Click" Padding="8,3" Margin="0,0,6,4" />
                                    <Button x:Name="RkJiny" AutomationProperties.AutomationId="RkJiny" Content="Jiný údaj, odstranit (U)" Tag="Jiny" Click="RkOznacit_Click" Padding="8,3" Margin="0,0,6,4" />
                                    <Button Content="Otevřít stranu" Click="RkOtevrit_Click" Padding="8,3" Margin="0,0,6,4" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <ListBox x:Name="RkSeznam" AutomationProperties.AutomationId="RkSeznam" SelectionChanged="RkSeznam_SelectionChanged"
                                 PreviewKeyDown="RkSeznam_PreviewKeyDown" FontSize="14" />
                    </DockPanel>
                </TabItem>
                <TabItem Header="Hledání" AutomationProperties.AutomationId="ZalozkaHledani">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="4">
                            <Button DockPanel.Dock="Right" Content="Hledat" Click="Hledat_Click" Padding="10,3" Margin="6,0,0,0" />
                            <TextBox x:Name="HledatPole" AutomationProperties.AutomationId="HledatPole" FontSize="15" KeyDown="HledatPole_KeyDown"
                                     ToolTip="Slovo nebo frázi ve všech stranách spisu. Nezáleží na diakritice, začátek slova najde i jiné tvary. Ctrl+F" />
                        </DockPanel>
                        <TextBlock x:Name="HledatSouhrn" AutomationProperties.AutomationId="HledatSouhrn" DockPanel.Dock="Top" Margin="8,0,8,4" Foreground="Gray" />
                        <ListBox x:Name="HledatVysledky" AutomationProperties.AutomationId="HledatVysledky" FontSize="14"
                                 MouseDoubleClick="HledatVysledky_Otevrit" KeyDown="HledatVysledky_Otevrit" />
                    </DockPanel>
                </TabItem>
                <TabItem Header="Data" AutomationProperties.AutomationId="ZalozkaData">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top" Margin="4">
                            <Button Content="Načíst znovu" Click="DataNacist_Click" Padding="8,3" Margin="0,0,6,0" />
                            <CheckBox x:Name="DataBezNarozeni" AutomationProperties.AutomationId="DataBezNarozeni" Content="Skrýt data narození" IsChecked="True"
                                      VerticalAlignment="Center" Margin="0,0,12,0" Click="DataNacist_Click" />
                            <Button Content="Uložit jako Word…" Click="DataUlozit_Click" Padding="8,3"
                                    ToolTip="Přehled dat pro vlastní potřebu. Obsahuje skutečné údaje, nedávat Claudovi." />
                        </WrapPanel>
                        <TextBlock x:Name="DataSouhrn" AutomationProperties.AutomationId="DataSouhrn" DockPanel.Dock="Top" Margin="8,0,8,4" Foreground="Gray" TextWrapping="Wrap" />
                        <ListBox x:Name="DataSeznam" AutomationProperties.AutomationId="DataSeznam" FontSize="14"
                                 MouseDoubleClick="DataSeznam_Otevrit" KeyDown="DataSeznam_Otevrit" />
                    </DockPanel>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" />

            <ScrollViewer x:Name="FotkaScroll" AutomationProperties.AutomationId="FotkaScroll" Grid.Column="4" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto" Background="#F0F0F0"
                          PreviewMouseWheel="FotkaScroll_PreviewMouseWheel">
                <Grid x:Name="Platno" AutomationProperties.AutomationId="Platno" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid.LayoutTransform>
                        <ScaleTransform x:Name="Meritko" AutomationProperties.AutomationId="Meritko" ScaleX="0.5" ScaleY="0.5" />
                    </Grid.LayoutTransform>
                    <Image x:Name="Fotka" AutomationProperties.AutomationId="Fotka" Stretch="Fill" Cursor="Hand"
                           MouseLeftButtonDown="Fotka_MouseLeftButtonDown" MouseMove="Fotka_MouseMove"
                           MouseLeftButtonUp="Fotka_MouseLeftButtonUp" />
                    <Canvas x:Name="Vrstva" AutomationProperties.AutomationId="Vrstva" IsHitTestVisible="False" />
                </Grid>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
