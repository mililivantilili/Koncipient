<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework Condition="'$(OS)' == 'Windows_NT'">net10.0-windows10.0.19041.0</TargetFramework>
    <TargetFramework Condition="'$(OS)' != 'Windows_NT'">net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Koncipient.Jadro</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Anonymizace\jmena.txt" LogicalName="Koncipient.Jadro.Anonymizace.jmena.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
    <PackageReference Include="WeCantSpell.Hunspell" Version="6.0.4" />
    <!-- PDF z datové schránky: text (PdfPig) a vykreslení stránky (PDFium přes PDFtoImage), vše offline -->
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Koncipient.Ocr\Koncipient.Ocr.csproj" />
  </ItemGroup>

</Project>
